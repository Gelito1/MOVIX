# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB API Credentials (server-side only)
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3

# MegamBD API Credentials (server-side only)
MEGAMBD_SERVER_URL=https://mgeb.space/player_api.php
MEGAMBD_EMBED_URL=https://megaembed.com
MEGAMBD_API_KEY=
MEGAMBD_USERNAME=
MEGAMBD_PASSWORD=

# Admin panel email, passcode & session signing secret
ADMIN_EMAIL=
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=

# Firebase Cloud Messaging (FCM HTTP v1) Service Account JSON (server-side only)
FIREBASE_SERVICE_ACCOUNT_JSON=

