{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user profile preferences and onboarding state stored at /users/{userId}. Contains no PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "User display name shown in the account menu."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL (empty string if none)."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["pt-BR", "pt-PT", "en", "es-419", "es-ES", "fr", "it"],
          "description": "Preferred catalog and subtitle language."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether the user opted in to release notifications."
        },
        "termsAccepted": {
          "type": "boolean",
          "description": "Whether the user accepted the MOVIX Terms & Conditions."
        },
        "termsVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9._\\-]+$",
          "description": "Version identifier of the accepted legal terms."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "preferredLanguage",
        "notificationsEnabled",
        "termsAccepted",
        "termsVersion",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-only isolated PII document stored at /users/{userId}/private/info.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "User email address isolated from public profile."
        },
        "provider": {
          "type": "string",
          "enum": ["google", "password"],
          "description": "Primary authentication provider."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of record creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "email", "provider", "createdAt", "updatedAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "A favorite movie or series synced to the user's cloud list.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "tmdbId": {
          "type": "number",
          "description": "Positive integer TMDB media identifier."
        },
        "mediaType": {
          "type": "string",
          "enum": ["movie", "tv"],
          "description": "Media type: movie or tv."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Display title of the movie or series."
        },
        "posterUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Poster image URL or empty string."
        },
        "year": {
          "type": "string",
          "maxLength": 10,
          "description": "Release year string."
        },
        "rating": {
          "type": "number",
          "description": "TMDB rating between 0 and 10."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "tmdbId",
        "mediaType",
        "title",
        "posterUrl",
        "year",
        "rating",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User-submitted support or problem report from the account and help screens.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Author Firebase Auth UID."
        },
        "category": {
          "type": "string",
          "enum": ["login", "reproducao", "conta", "legal", "outro"],
          "description": "Issue category."
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "description": "User issue description."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Ticket lifecycle status. 'resolved' is terminal for non-admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "category", "message", "status", "createdAt", "updatedAt"]
    },
    "SystemPublicConfig": {
      "title": "SystemPublicConfig",
      "description": "Public-safe platform settings, branding, institutional pages, and ad pacing synced in real time across all MOVIX environments at /systemConfig/public.",
      "type": "object",
      "properties": {
        "platformName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public platform display name."
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional custom logo URL."
        },
        "faviconUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional custom favicon URL."
        },
        "primaryColor": {
          "type": "string",
          "maxLength": 20,
          "description": "Hex brand accent color."
        },
        "heroTagline": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional public hero tagline."
        },
        "seoTitle": {
          "type": "string",
          "maxLength": 160,
          "description": "SEO page title."
        },
        "seoDescription": {
          "type": "string",
          "maxLength": 400,
          "description": "SEO meta description."
        },
        "seoKeywords": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional SEO keywords."
        },
        "aboutUs": {
          "type": "string",
          "maxLength": 5000,
          "description": "Optional About Us public text."
        },
        "privacyPolicy": {
          "type": "string",
          "maxLength": 8000,
          "description": "Optional Privacy Policy public text."
        },
        "termsOfUse": {
          "type": "string",
          "maxLength": 8000,
          "description": "Optional Terms of Use public text."
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional public contact email."
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional public contact phone."
        },
        "socialInstagram": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional Instagram link."
        },
        "socialYoutube": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional YouTube link."
        },
        "socialTelegram": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional Telegram link."
        },
        "socialTwitter": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional Twitter/X link."
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["pt-BR", "pt-PT", "en", "es-419", "es-ES", "fr", "it"],
          "description": "Default platform language."
        },
        "maintenanceMode": {
          "type": "boolean",
          "description": "Whether the public platform is in maintenance mode."
        },
        "adsGlobalEnabled": {
          "type": "boolean",
          "description": "Global switch enabling or disabling MOVIX ADS."
        },
        "dismissCooldownMinutes": {
          "type": "number",
          "description": "Minutes before large ads reappear after a user closes one (1-1440)."
        },
        "largeAdIntervalMinutes": {
          "type": "number",
          "description": "Minimum interval in minutes between large ad appearances (0-1440)."
        },
        "playerAdIntervalMinutes": {
          "type": "number",
          "description": "Minimum interval in minutes between video player overlay ads (0-1440)."
        },
        "headerAdAlwaysVisible": {
          "type": "boolean",
          "description": "Whether the compact top header strip ad always appears without cooldown."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Verified admin UID who last updated system config."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update."
        }
      },
      "required": [
        "platformName",
        "logoUrl",
        "faviconUrl",
        "primaryColor",
        "heroTagline",
        "seoTitle",
        "seoDescription",
        "defaultLanguage",
        "maintenanceMode",
        "adsGlobalEnabled",
        "dismissCooldownMinutes",
        "largeAdIntervalMinutes",
        "playerAdIntervalMinutes",
        "headerAdAlwaysVisible",
        "updatedBy",
        "updatedAt"
      ]
    },
    "PublicAdCampaign": {
      "title": "PublicAdCampaign",
      "description": "Permanent public-safe ad campaign metadata synced across MOVIX environments at /publicAds/{adId}.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Campaign identifier matching document ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Campaign internal name."
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Public headline."
        },
        "description": {
          "type": "string",
          "maxLength": 600,
          "description": "Public description."
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Ad format identifier."
        },
        "mediaKind": {
          "type": "string",
          "enum": ["image", "video"],
          "description": "Creative media type."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Creative image or poster URL."
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Creative video URL."
        },
        "destinationUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Click-through destination URL."
        },
        "ctaText": {
          "type": "string",
          "maxLength": 80,
          "description": "Call-to-action button label."
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "scheduled", "expired", "draft"],
          "description": "Campaign delivery status."
        },
        "priority": {
          "type": "number",
          "description": "Delivery priority (1-100)."
        },
        "placements": {
          "type": "array",
          "description": "Target placements in MOVIX (max 20)."
        },
        "devices": {
          "type": "array",
          "description": "Target devices (max 6)."
        },
        "autoplay": {
          "type": "boolean",
          "description": "Whether video ads autoplay."
        },
        "startMuted": {
          "type": "boolean",
          "description": "Whether video ads start muted."
        },
        "skippable": {
          "type": "boolean",
          "description": "Whether player ads can be skipped."
        },
        "skipAfterSeconds": {
          "type": "number",
          "description": "Seconds before skip button unlocks (0-120)."
        },
        "durationSeconds": {
          "type": "number",
          "description": "Maximum ad duration in seconds (1-300)."
        },
        "frequencyPerSession": {
          "type": "number",
          "description": "Target impressions per session (1-100)."
        },
        "startDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional campaign start date."
        },
        "endDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional campaign end date."
        },
        "maxImpressions": {
          "type": "number",
          "description": "Optional impression cap."
        },
        "targetAudience": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional audience label."
        },
        "countries": {
          "type": "array",
          "description": "Optional country ISO codes (max 50)."
        },
        "impressions": {
          "type": "number",
          "description": "Persisted total impressions count."
        },
        "clicks": {
          "type": "number",
          "description": "Persisted total clicks count."
        },
        "videoViews": {
          "type": "number",
          "description": "Persisted video views count."
        },
        "videoCompletes": {
          "type": "number",
          "description": "Persisted video completes count."
        },
        "videoPartials": {
          "type": "number",
          "description": "Persisted video partials count."
        },
        "totalWatchSeconds": {
          "type": "number",
          "description": "Persisted total video watch seconds."
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional ISO creation timestamp."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Verified admin UID."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update."
        }
      },
      "required": [
        "id",
        "name",
        "title",
        "description",
        "format",
        "mediaKind",
        "imageUrl",
        "videoUrl",
        "destinationUrl",
        "ctaText",
        "status",
        "priority",
        "placements",
        "devices",
        "autoplay",
        "startMuted",
        "skippable",
        "skipAfterSeconds",
        "durationSeconds",
        "frequencyPerSession",
        "updatedBy",
        "updatedAt"
      ]
    },
    "PublicCatalogList": {
      "title": "PublicCatalogList",
      "description": "Permanent admin-managed catalog lists (banners, highlights, categories, genres, servers) stored as native Firestore maps/lists at /publicCatalogLists/{listId}.",
