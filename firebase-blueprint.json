        },
        "items": {
          "type": "array",
          "description": "Bounded list of up to 100 native item maps."
        },
        "itemCount": {
          "type": "number",
          "description": "Number of items in the list (0-100)."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Verified admin UID."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["listId", "items", "itemCount", "updatedBy", "updatedAt"]
    },
