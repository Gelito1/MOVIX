    "PublicMediaAsset": {
      "title": "PublicMediaAsset",
      "description": "Permanent cloud-backed uploaded image or small media asset stored at /publicMedia/{mediaId} so creatives survive app updates.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Asset identifier matching document ID."
        },
        "folder": {
          "type": "string",
          "enum": ["posters", "backdrops", "ads-images", "ads-videos", "branding", "notifications", "categories"],
          "description": "Logical media folder."
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._\\-]+$",
          "description": "Sanitized filename."
        },
        "mimeType": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/webp", "image/gif", "video/mp4", "video/webm"],
          "description": "Validated MIME type."
        },
        "dataUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700000,
          "description": "Bounded base64 data URI of compressed media asset."
        },
        "sizeBytes": {
          "type": "number",
          "description": "Asset byte size (1-700000)."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Verified admin UID."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of upload."
        }
      },
      "required": ["id", "folder", "filename", "mimeType", "dataUrl", "sizeBytes", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile preferences without PII; readable and writable only by the owner."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated user PII (email, auth provider); strictly owner-only."
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/UserFavorite" },
      "description": "User-owned cloud-synced favorites subcollection requiring parent profile existence."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "User-submitted problem reports; owners can read their own and create open tickets."
    },
    "/systemConfig/{configId}": {
      "schema": { "$ref": "#/entities/SystemPublicConfig" },
      "description": "Singleton public platform settings doc ('public') readable by all visitors and writable exclusively by verified admins."
    },
    "/publicAds/{adId}": {
      "schema": { "$ref": "#/entities/PublicAdCampaign" },
      "description": "Permanent synced ad campaigns; active campaigns are readable by visitors, all CRUD restricted exclusively to verified admins."
    },
    "/publicCatalogLists/{listId}": {
      "schema": { "$ref": "#/entities/PublicCatalogList" },
      "description": "Permanent admin-managed banners, highlights, categories, genres, and playback servers; public get by exact doc ID, admin-only writes."
    },
    "/publicMovies/{movieId}": {
      "schema": { "$ref": "#/entities/PublicMovie" },
      "description": "Permanent admin-managed movies; published movies are readable by visitors, all CRUD restricted exclusively to verified admins."
    },
    "/publicSeries/{seriesId}": {
      "schema": { "$ref": "#/entities/PublicSeries" },
      "description": "Permanent admin-managed series with seasons and episodes; published series are readable by visitors, all CRUD restricted exclusively to verified admins."
    },
    "/publicMedia/{mediaId}": {
      "schema": { "$ref": "#/entities/PublicMediaAsset" },
      "description": "Permanent cloud-backed uploaded images and small media assets; public get by exact ID (no list), admin-only CRUD."
    }
  }
}
